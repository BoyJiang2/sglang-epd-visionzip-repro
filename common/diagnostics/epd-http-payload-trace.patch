+def _encode_tcp_payload(sock):
+    # The Linux 5.15 x86_64 UAPI places bytes_sent and bytes_retrans here.
+    # TCP_INFO on a retired transport is unavailable and must not count as zero.
+    if sock is None or not hasattr(socket, "TCP_INFO"):
+        return None
+    try:
+        info = sock.getsockopt(socket.IPPROTO_TCP, socket.TCP_INFO, 216)
+        return struct.unpack_from("=QQ", info, 200)
+    except (OSError, struct.error):
+        return None
+
