diff --git a/python/sglang/srt/disaggregation/encoder/visionzip.py b/python/sglang/srt/disaggregation/encoder/visionzip.py
new file mode 100644
index 0000000..a78db73
--- /dev/null
+++ b/python/sglang/srt/disaggregation/encoder/visionzip.py
@@ -0,0 +1,71 @@
+"""VisionZip for image-only Qwen2.5-VL E/PD, using the original visual positions."""
+
+import torch
+import torch.nn.functional as F
+
+
+def image_statistics(query, key, patch_counts, merge_size, reverse_indices):
+    """Reproduce incoming attention mass and mean key per merged patch group."""
+    masses, keys = [], []
+    for q, k in zip(query.split(patch_counts), key.split(patch_counts)):
+        q, k = q.transpose(0, 1), k.transpose(0, 1)
+        mass = torch.zeros(k.shape[1], dtype=torch.float32, device=k.device)
+        for block in q.split(128, dim=1):
+            logits = block @ k.transpose(1, 2)
+            weights = (logits * (q.shape[-1] ** -0.5)).softmax(dim=-1)
+            mass += weights.float().sum(dim=(0, 1)) / q.shape[0]
+        masses.append(mass.view(-1, merge_size).mean(dim=-1))
+        keys.append(k.reshape(k.shape[0], -1, merge_size, k.shape[-1]).mean(2).mean(0))
+    return torch.cat(masses)[reverse_indices], torch.cat(keys)[reverse_indices]
+
+
+def compress_image(embedding, score, key, ratio):
+    """Select dominant tokens, then merge remaining tokens into contextual anchors."""
+    rows = embedding.shape[0]
+    if ratio == 100:
+        return embedding, list(range(rows))
+    dominant = score.topk(int((ratio - 5) * rows / 100)).indices
+    mask = torch.ones(rows, dtype=torch.bool, device=embedding.device)
+    mask[dominant] = False
+    rest = mask.nonzero().flatten()
+    count = max(int(0.05 * rows), 1)
+    stride = max(rest.numel() // count, 1)
+    anchor = rest[::stride][:count]
+    mask[anchor] = False
+    others = mask.nonzero().flatten()
+    keys = F.normalize(key.float(), dim=-1)
+    similarity = keys[others] @ keys[anchor].transpose(0, 1)
+    assigned = similarity.argmax(dim=1)
+    membership = F.one_hot(assigned, num_classes=anchor.numel()).to(embedding.dtype)
+    counts = membership.sum(dim=0).clamp(min=1).unsqueeze(1)
+    merged = embedding[anchor] + membership.transpose(0, 1) @ embedding[others] / counts
+    order = torch.cat((dominant, anchor)).argsort()
+    keep = torch.cat((dominant, anchor))[order]
+    features = torch.cat((embedding[dominant], merged), dim=0)[order]
+    return features, keep.tolist()
+
+
+def compact_prompt(input_ids, offsets, positions, delta, selections):
+    """Retain original coordinates while accounting for a shorter physical KV sequence."""
+    if len(offsets) != len(selections):
+        raise ValueError("VisionZip image offset/selection count mismatch")
+    keep, new_offsets = [], []
+    end = 0
+    for (start, stop), selected in zip(offsets, selections):
+        if not selected or list(sorted(set(selected))) != selected:
+            raise ValueError("VisionZip indices must be nonempty, unique and sorted")
+        if not 0 <= end <= start <= stop < len(input_ids):
+            raise ValueError("VisionZip image offsets must be ordered and disjoint")
+        if selected[0] < 0 or selected[-1] > stop - start:
+            raise ValueError("VisionZip index is outside its original image span")
+        keep.extend(range(end, start))
+        new_offsets.append((len(keep), len(keep) + len(selected) - 1))
+        keep.extend(start + index for index in selected)
+        end = stop + 1
+    keep.extend(range(end, len(input_ids)))
+    return (
+        [input_ids[i] for i in keep],
+        new_offsets,
+        positions[:, keep],
+        delta + len(input_ids) - len(keep),
+    )
